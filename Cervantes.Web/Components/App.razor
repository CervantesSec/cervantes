<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="stylesheet" href="app.css"/>
    <link rel="stylesheet" href="Cervantes.Web.styles.css"/>
    <link rel="icon" type="image/png" href="img/favicon.ico"/>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link id="mudex-styles" href="_content/MudBlazor.Extensions/mudBlazorExtensions.min.css" rel="stylesheet">
    <link href="_content/CodeBeam.MudBlazor.Extensions/MudExtensions.min.css" rel="stylesheet" />
    <link href="_content/Blazor.Flags/flags.css" rel="stylesheet" />
    <link href="lib/prism/prism.css" rel="stylesheet" />
    <HeadOutlet @rendermode="RenderModeForPage"/>
</head>

<body>
<Routes @rendermode="RenderModeForPage" />
<script src="_framework/blazor.web.js"></script>
<script src="_content/MudBlazor/MudBlazor.min.js"></script>
<script src="_content/CodeBeam.MudBlazor.Extensions/MudExtensions.min.js"></script>
<script src="lib/saveFile.js"></script>
<script src="_content/BlazorMonaco/jsInterop.js"></script>
<script src="lib/monaco-environment.js"></script>
<script src="lib/monaco-loader.js"></script>
<script src="lib/prism/prism.js" data-manual></script>
<script src="lib/prism/initPrism.js"></script>

</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Static vs interactive rendering of /Account pages: see AccountPages.
    private IComponentRenderMode? RenderModeForPage =>
        Cervantes.Web.Helpers.AccountPages.UsesStaticRender(HttpContext.Request.Path)
            ? null
            : InteractiveServer;
}